# Production environment secrets template for AWS EC2 Deployment
# On your AWS EC2 server, copy this file and fill in your real credentials:
#   cp .env.prod.example .env.prod

# ── PostgreSQL Security Configuration ────────────────────────────────
POSTGRES_USER=sectoral_admin
POSTGRES_PASSWORD=replace_with_a_secure_random_password
POSTGRES_DB=sectoral_db

# ── Gemini LLM Settings ──────────────────────────────────────────────
GEMINI_API_KEY=your_actual_gemini_api_key_here

# ── Frontend CORS Allow-list ──────────────────────────────────────────
# Include your actual Vercel deployment domain (NO trailing slash!)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# ── Application Environment ──────────────────────────────────────────
ENVIRONMENT=production
